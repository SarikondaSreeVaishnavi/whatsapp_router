# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# MongoDB Atlas connection string.
# In Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <username>/<password>/<dbname> with your own.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/whatsapp_router?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# How long a login session lasts before the user must log in again.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=5000

# The exact origin your React dev server / production frontend runs on.
# Used for CORS + cookie settings. No trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# "development" or "production". In production, cookies are sent with
# Secure + SameSite=None (requires HTTPS) instead of Lax.
NODE_ENV=development
